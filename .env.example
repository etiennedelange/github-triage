# Optional. Without it the app uses `gh auth token` from the GitHub CLI.
# Fine-grained token: read access to Metadata, Pull requests, Issues, Dependabot alerts,
# Code scanning alerts and Secret scanning alerts on the repos you want covered.
# Classic token: `repo` + `security_events` (or `public_repo` for public repos only).
GITHUB_TOKEN=

# Optional. Comma-separated orgs whose repos also count as "yours" for
# incoming PRs, untriaged issues and security scans.
TRIAGE_OWNERS=

# Optional. Cap on repos scanned for security alerts, most recently pushed first. Default 50.
TRIAGE_MAX_REPOS=
