{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-triage",
  // Hono app: auth, webhook, live socket and JSON API; serves the Vite-built SPA behind the session.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    // Every request goes through the Worker first, so the app itself sits behind the session check.
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  // The Hub is the app's only store: OAuth tokens, the inbox snapshot, the security report, live sockets.
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "observability": { "enabled": true },
  "vars": {
    // Comma-separated GitHub logins allowed to sign in.
    "ALLOWED_LOGINS": "etiennedelange",
    "TRIAGE_OWNERS": ""
  },
  // `wrangler preview`: same (non-secret) vars as production, since ALLOWED_LOGINS is just a login list.
  "previews": {
    "vars": {
      "ALLOWED_LOGINS": "etiennedelange",
      "TRIAGE_OWNERS": ""
    }
  }
  // Secrets (wrangler secret put): GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITHUB_WEBHOOK_SECRET, SESSION_SECRET
}
